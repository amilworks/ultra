# Optional overrides for the docker-compose stack. These are SEPARATE from the
# app's `.env` (which is for the run-from-source path). You usually don't need
# this file — `docker compose up --build` works out of the box against a HOST
# Ollama with gpt-oss:20b. To customize:
#
#   cp .env.docker.example .env.docker
#   # edit, then:
#   docker compose --env-file .env.docker up --build
#
# (or just set any of these as shell env vars before `docker compose up`.)

# --- Production parity knobs (change these and you stop testing production) ----
# The compose stack defaults to a PRODUCTION MIRROR. ENVIRONMENT=production is the
# highest-value setting here: the Go config validation returns early for anything
# else, so with `development` the entire production requirement block (durable
# backends, auth provider) is never exercised locally.
ULTRA_ENVIRONMENT=production
# Production NATS requires a token. Clients use the userinfo form
# nats://<token>@host (NO colon — the :<token> form is sent as a password and is
# rejected by token auth).
ULTRA_NATS_TOKEN=local-dev-nats-token
# Production runs multiple workers on ONE durable (a queue group). Keep >=2 so
# competing consumers, run leases, and redelivery are actually exercised.
ULTRA_WORKER_REPLICAS=2
# Reuse an existing, already-migrated database instead of the stack's own
# Postgres (e.g. the native dev stack's DB on the host):
# ULTRA_DATABASE_URL=postgres://postgres:postgres@host.docker.internal:55432/bisque_ultra?sslmode=disable

# --- Model server (OpenAI-compatible: Ollama or vLLM running on your host) -----
# Ollama default. For vLLM use e.g. http://host.docker.internal:8001/v1.
ULTRA_MODEL_BASE_URL=http://host.docker.internal:11434/v1
ULTRA_MODEL_NAME=gpt-oss:20b
ULTRA_MODEL_API_KEY=EMPTY

# --- Ports published on your machine ------------------------------------------
FRONTEND_PORT=5174
CONTROL_PORT=8000
IMAGE_SERVICE_PORT=8099
NGFF_SERVICE_PORT=8092

# --- Data dir (host-path equivalence — important) -----------------------------
# The worker runs each run's code in a sandbox via the HOST Docker daemon, which
# bind-mounts the run workspace/artifacts BY HOST PATH. So this must resolve to the
# SAME absolute path inside the worker AND on the host (compose uses an identical-path
# bind, not a named volume). /tmp/ultra-data works but is ephemeral; use a stable
# path (e.g. /srv/ultra-data) to keep artifacts across reboots.
ULTRA_DATA_DIR=/tmp/ultra-data

# --- Auth ---------------------------------------------------------------------
# Production runs WorkOS. `dev` (a local username/password form) is the ONE
# deliberate parity break, kept for a fast inner loop: production refuses dev auth
# unless ULTRA_ALLOW_DEV_AUTH is true. Before trusting a rollout that touches
# auth, sessions, cookies or redirects, run the real path: set
# ULTRA_AUTH_PROVIDER=workos and fill the WorkOS values below (redirect URIs
# already default to the edge origin, since the SPA and API are same-origin here
# exactly as behind the production edge).
ULTRA_AUTH_PROVIDER=dev
ULTRA_ALLOW_DEV_AUTH=true
ULTRA_DEV_ADMIN_ENABLED=true
ULTRA_WORKER_TOKEN=local-dev-worker-token
ULTRA_WORKOS_CLIENT_ID=
ULTRA_WORKOS_API_KEY=
ULTRA_WORKOS_COOKIE_PASSWORD=
# Bootstrap admin allowlist — the same mechanism production uses to grant the
# admin console (comma-separated, case-insensitive).
ULTRA_ADMIN_EMAILS=
# Local-only key; production validation requires one whenever BisQue is
# configured (linked BisQue credentials are AES-256-GCM sealed with it).
ULTRA_SECRET_ENCRYPTION_KEY=bG9jYWwtZGV2LW9ubHkta2V5LWRvLW5vdC1zaGlwISE=

# --- Code-exec sandbox --------------------------------------------------------
# Aggregate per-worker cap on simultaneous sandbox containers. 0 = unbounded (fine
# for a single worker). Set a finite value BEFORE running more than one worker
# (make scale-workers N=...) so replicas can't oversubscribe one Docker daemon.
ULTRA_SANDBOX_MAX_CONCURRENCY=0
ULTRA_SANDBOX_QUEUE_TIMEOUT_SECONDS=120
# Per-container caps (empty = Docker default). Set a memory cap (e.g. 8g) when
# scaling workers so one runaway sandbox cannot OOM the shared host.
ULTRA_SANDBOX_MEMORY=
ULTRA_SANDBOX_SHM_SIZE=

# --- Image engine build -------------------------------------------------------
# Pin the libbioimage (BioImageConvert) source to a known-good commit for a
# reproducible build; upstream "main" can drift and break `up --build`.
BIOIMAGE_REF=main

# --- Optional external vision VLM (OFF by default) ----------------------------
# We never host this GPU. Enable only with a reachable OpenAI-compatible VLM
# endpoint; false keeps the vision-reasoner subagent disabled.
ULTRA_QWEN_VLM_ENABLED=false
ULTRA_QWEN_VLM_BASE_URL=
ULTRA_QWEN_VLM_MODEL=
ULTRA_QWEN_VLM_MODEL_REVISION=
ULTRA_QWEN_VLM_RUNTIME_IDENTITY=
# Durable table evidence remains disabled unless this canonical attestation is
# available inside the container (placing a host-protected file under the shared
# ULTRA_DATA_DIR is one option) and its exact digest is pinned separately.
# Revision/runtime strings alone are not attestation.
ULTRA_QWEN_VLM_DEPLOYMENT_ATTESTATION_PATH=
ULTRA_QWEN_VLM_DEPLOYMENT_ATTESTATION_SHA256=
ULTRA_QWEN_VLM_API_KEY=

# --- Optional external GPU MegaSeg service (OFF by default) --------------------
ULTRA_MEGASEG_SERVICE_URL=
ULTRA_MEGASEG_SERVICE_API_KEY=

# --- Optional BisQue integration (leave empty for a self-contained local run) --
ULTRA_BISQUE_ROOT_URL=
