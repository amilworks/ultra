# Optional overrides for the docker-compose stack. These are SEPARATE from the
# app's `.env` (which is for the run-from-source path). You usually don't need
# this file — `docker compose up --build` works out of the box against a HOST
# Ollama with gpt-oss:20b. To customize:
#
#   cp .env.docker.example .env.docker
#   # edit, then:
#   docker compose --env-file .env.docker up --build
#
# (or just set any of these as shell env vars before `docker compose up`.)

# --- Model server (OpenAI-compatible: Ollama or vLLM running on your host) -----
# Ollama default. For vLLM use e.g. http://host.docker.internal:8001/v1.
ULTRA_MODEL_BASE_URL=http://host.docker.internal:11434/v1
ULTRA_MODEL_NAME=gpt-oss:20b
ULTRA_MODEL_API_KEY=EMPTY

# --- Ports published on your machine ------------------------------------------
FRONTEND_PORT=5174
CONTROL_PORT=8000
IMAGE_SERVICE_PORT=8099
NGFF_SERVICE_PORT=8092

# --- Data dir (host-path equivalence — important) -----------------------------
# The worker runs each run's code in a sandbox via the HOST Docker daemon, which
# bind-mounts the run workspace/artifacts BY HOST PATH. So this must resolve to the
# SAME absolute path inside the worker AND on the host (compose uses an identical-path
# bind, not a named volume). /tmp/ultra-data works but is ephemeral; use a stable
# path (e.g. /srv/ultra-data) to keep artifacts across reboots.
ULTRA_DATA_DIR=/tmp/ultra-data

# --- Auth ---------------------------------------------------------------------
# dev = a local username/password form, no cloud. (workos requires WorkOS keys.)
ULTRA_AUTH_PROVIDER=dev
ULTRA_WORKER_TOKEN=local-dev-worker-token

# --- Code-exec sandbox --------------------------------------------------------
# Aggregate per-worker cap on simultaneous sandbox containers. 0 = unbounded (fine
# for a single worker). Set a finite value BEFORE running more than one worker
# (make scale-workers N=...) so replicas can't oversubscribe one Docker daemon.
ULTRA_SANDBOX_MAX_CONCURRENCY=0
ULTRA_SANDBOX_QUEUE_TIMEOUT_SECONDS=120
# Per-container caps (empty = Docker default). Set a memory cap (e.g. 8g) when
# scaling workers so one runaway sandbox cannot OOM the shared host.
ULTRA_SANDBOX_MEMORY=
ULTRA_SANDBOX_SHM_SIZE=

# --- Image engine build -------------------------------------------------------
# Pin the libbioimage (BioImageConvert) source to a known-good commit for a
# reproducible build; upstream "main" can drift and break `up --build`.
BIOIMAGE_REF=main

# --- Optional external vision VLM (OFF by default) ----------------------------
# We never host this GPU. Enable only with a reachable OpenAI-compatible VLM
# endpoint; false keeps the vision-reasoner subagent disabled.
ULTRA_QWEN_VLM_ENABLED=false
ULTRA_QWEN_VLM_BASE_URL=
ULTRA_QWEN_VLM_MODEL=
ULTRA_QWEN_VLM_API_KEY=

# --- Optional external GPU MegaSeg service (OFF by default) --------------------
ULTRA_MEGASEG_SERVICE_URL=
ULTRA_MEGASEG_SERVICE_API_KEY=

# --- Optional BisQue integration (leave empty for a self-contained local run) --
ULTRA_BISQUE_ROOT_URL=
