# Environment configuration
# Copy this file to .env and update values for your local development environment.
# Leave unset to default query-param auth compatibility to on in development and off in production.
ALLOW_QUERY_API_KEY_COMPAT=
# For production, use deploy/env/ultra-backend.env.example as the server-side
# EnvironmentFile template instead of deploying one monolithic repo .env.

# Application
APP_NAME=Bisque Ultra
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false

# Server
UI_SHOW_DIAGNOSTICS_DEFAULT=false
UI_AUTO_REPRO_REPORT=false
UI_FORCE_TOOL_VISUALIZATIONS=true
BISQUE_ENABLE_STREAMLIT_RUNTIME_BRIDGE=false

# Logging
LOG_LEVEL=INFO

# Security
ENABLE_CORS=false
ALLOWED_ORIGINS=[]

# Performance
MAX_UPLOAD_SIZE=200

# LLM provider routing (centralized)
# Supported providers: vllm, openai, ollama
LLM_PROVIDER=vllm
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Response verbosity: concise | balanced | detailed
LLM_RESPONSE_VERBOSITY=detailed
LLM_MOCK_MODE=false

# Optional coding-model override (used only by codegen_python_plan)
CODEGEN_PROVIDER=
CODEGEN_BASE_URL=
CODEGEN_API_KEY=
CODEGEN_MODEL=
CODEGEN_TIMEOUT_SECONDS=

# Optional Pro Mode frontier-model override.
# Use `openai_compatible` for OpenAI/vLLM-style gateways, `bedrock_published_api` for
# API Gateway publishes that expose `/conversation`, and `aws_bedrock_claude` for
# Agno's native AWS Bedrock Claude transport.
PRO_MODE_TRANSPORT=openai_compatible
# For API Gateway protected publishes, set PRO_MODE_API_KEY_HEADER=X-API-Key and leave
# PRO_MODE_API_KEY_PREFIX blank so the key is sent as a raw x-api-key header.
PRO_MODE_BASE_URL=
PRO_MODE_API_KEY=
PRO_MODE_API_KEY_HEADER=
PRO_MODE_API_KEY_PREFIX=
PRO_MODE_MODEL=
PRO_MODE_DEFAULT_HEADERS={}
PRO_MODE_DEFAULT_QUERY={}
PRO_MODE_TIMEOUT_SECONDS=
PRO_MODE_FALLBACK_ENABLED=true
# Native AWS Bedrock Claude transport:
# - Prefer AWS_PROFILE/AWS_REGION in your shell for local testing, or set the
#   dedicated PRO_MODE_AWS_* values below.
# - Use one native auth strategy: PRO_MODE_AWS_BEARER_TOKEN, AWS profile/SSO, or
#   AWS access keys. Do not reuse API Gateway X-API-Key publish tokens here.
# - PRO_MODE_MODEL must be the Bedrock model identifier, not the published API alias.
#   Example: anthropic.claude-opus-4-5-20251101-v1:0
PRO_MODE_AWS_REGION=
PRO_MODE_AWS_PROFILE=
PRO_MODE_AWS_ACCESS_KEY_ID=
PRO_MODE_AWS_SECRET_ACCESS_KEY=
PRO_MODE_AWS_SESSION_TOKEN=
PRO_MODE_AWS_BEARER_TOKEN=
PRO_MODE_AWS_SSO_AUTH=false

# Provider defaults/fallbacks
# BisQue Ultra speaks to OpenAI-compatible endpoints. For local vLLM, point this at
# the vLLM server, usually on a different port than the FastAPI app.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:8001/v1
OPENAI_MODEL=gpt-oss-120b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b-instruct
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=2

# Optional medical-domain routing
# When AGENTS_MEDICAL_BASE_URL is set, only the medical specialist can route to that endpoint.
# If the medical endpoint is unavailable, the runtime falls back to the global model path.
AGENTS_MODEL_MEDICAL=
AGENTS_MEDICAL_BASE_URL=
AGENTS_MEDICAL_API_KEY=
AGENTS_MEDICAL_TIMEOUT_SECONDS=60
AGENTS_MEDICAL_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
AGENTS_MEDICAL_MULTIMODAL_ENABLED=true
AGENTS_MEDICAL_MAX_IMAGES_PER_PROMPT=3
AGENTS_MEDICAL_MAX_INLINE_IMAGE_BYTES=1500000

# Optional Megaseg runtime overrides
MEGASEG_PYTHON=
CYTODL_PYTHON=
MEGASEG_CHECKPOINT_PATH=
MEGASEG_BENCHMARK_ROOT=
MEGASEG_SERVICE_URL=
MEGASEG_SERVICE_API_KEY=
MEGASEG_SERVICE_TIMEOUT_SECONDS=60
MEGASEG_SERVICE_POLL_INTERVAL_SECONDS=2
MEGASEG_SERVICE_WAIT_TIMEOUT_SECONDS=7200
MEGASEG_SERVICE_DOWNLOAD_ARTIFACTS=true

YOLO_DEFAULT_MODEL=data/models/yolo/yolo26x.pt
YOLOV5_RUNTIME_PATH=third_party/yolov5
YOLOV5_RARESPOT_WEIGHTS=data/models/yolo/RareSpotWeights.pt
PRAIRIE_ACTIVE_LEARNING_DATASET_NAME=Prairie_Dog_Active_Learning
PRAIRIE_SYNC_INTERVAL_SECONDS=21600
PRAIRIE_FIXED_EPOCHS=20
PRAIRIE_FIXED_BATCH_SIZE=4
PRAIRIE_FIXED_IMGSZ=512
PRAIRIE_FIXED_CONF_THRESHOLD=0.25
PRAIRIE_FIXED_IOU_THRESHOLD=0.45
PRAIRIE_RETRAIN_MIN_REVIEWED_SAMPLES=25

# Postgres (local production-like testing)
COMPOSE_PROJECT_NAME=bisque-legacy
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
BISQUE_POSTGRES_PORT=55433
POSTGRES_DB=bisque_ultra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Go control plane
ULTRA_CONTROL_APP_NAME=BisQue Ultra Control Plane
ULTRA_CONTROL_APP_VERSION=0.1.0
ULTRA_CONTROL_HTTP_ADDR=127.0.0.1:8088
ULTRA_CONTROL_READ_HEADER_TIMEOUT_SECONDS=10
ULTRA_CONTROL_READ_TIMEOUT_SECONDS=0
ULTRA_CONTROL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/bisque_ultra
ULTRA_CONTROL_DATABASE_MAX_CONNS=8
ULTRA_CONTROL_DATABASE_MIN_CONNS=0
# Per-query server-side timeout (Postgres statement_timeout) on the SERVING pool so a
# single stuck/runaway query can't hold a pooled connection and starve the small pool.
# 0 disables (default), matching ULTRA_CONTROL_{READ,WRITE}_TIMEOUT_SECONDS; set e.g. 30
# in production. Migrations are exempt (their DDL is legitimately slow).
ULTRA_CONTROL_DATABASE_STATEMENT_TIMEOUT_SECONDS=0
ULTRA_CONTROL_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/bisque_ultra_test
ULTRA_CONTROL_NATS_URL=nats://127.0.0.1:4222
# 32-byte AES-GCM key used by Go to encrypt stored external-service secrets.
# Generate with: openssl rand -base64 32
ULTRA_CONTROL_SECRET_ENCRYPTION_KEY=
ULTRA_CONTROL_SECRET_ENCRYPTION_KEY_ID=local-dev-key
# Production auth uses WorkOS AuthKit. Keep "dev" for local development.
ULTRA_CONTROL_AUTH_PROVIDER=dev
ULTRA_CONTROL_WORKOS_CLIENT_ID=
ULTRA_CONTROL_WORKOS_API_KEY=
ULTRA_CONTROL_WORKOS_REDIRECT_URI=http://localhost:5174/v2/auth/workos/callback
ULTRA_CONTROL_WORKOS_POST_LOGIN_REDIRECT_URI=http://localhost:5174/
ULTRA_CONTROL_WORKOS_LOGOUT_REDIRECT_URI=http://localhost:5174/
# Generate a high-entropy cookie password (32+ chars required): openssl rand -hex 32
ULTRA_CONTROL_WORKOS_COOKIE_PASSWORD=
ULTRA_CONTROL_WORKOS_COOKIE_SECURE=false
ULTRA_CONTROL_NATS_STREAM=ULTRA_RUNS
ULTRA_CONTROL_NATS_JOBS_SUBJECT=ultra.runs.jobs
ULTRA_CONTROL_NATS_RARESPOT_JOBS_SUBJECT=ultra.runs.rarespot.jobs
ULTRA_CONTROL_NATS_EVENTS_SUBJECT=ultra.runs.events
ULTRA_CONTROL_ARTIFACT_ROOT=data/artifacts
# libbioimage image service: decode/convert + tiled-pyramid tile serving. When set,
# the control plane proxies /viewer, /slice, /histogram, /scalar-volume, /tiles, and
# /atlas to it (and auto-derives pyramids on upload). Run scripts/run_image_service.sh.
# Leave empty to keep the legacy native Go image path.
ULTRA_CONTROL_IMAGE_SERVICE_URL=http://127.0.0.1:8099
# Hard ceiling on concurrent HTTP connections the control plane opens to the image
# service (MaxConnsPerHost): a warm keep-alive pool for deep-zoom tile bursts plus
# backpressure so the control plane can never flood the engine. Default 32. On a
# dedicated image node, raise toward the total engine worker count across replicas.
ULTRA_CONTROL_IMAGE_SERVICE_MAX_CONNS=32
# Image-service container knobs (read by scripts/run_image_service.sh + the convert
# worker, NOT the Go control plane). Each worker is one libbioimage engine behind a
# global decode lock, so tile concurrency scales with worker COUNT; empty = auto
# (cores/2, floor 2, cap 8) — raise on a dedicated image node.
ULTRA_IMGSVC_WORKERS=
# Redelivery cap for a failing image.derive_pyramid convert job before it is
# dead-lettered, so a poison/unconvertible source can't loop the consumer forever.
ULTRA_IMGSVC_MAX_DELIVER=5
# 4D NIfTI (fMRI) random-access cache. Scalar volumes always stream one timepoint
# at a time (bounded memory); when enabled, a gzipped 4D series is also
# decompressed once to a derived uncompressed .nii so any timepoint serves via an
# O(1) seek (fast time-scrubbing). Costs one decompressed copy on disk per 4D
# series; set to 0 to keep streaming-only with zero extra disk.
ULTRA_CONTROL_NIFTI_DECOMPRESS_CACHE=true
ULTRA_CONTROL_DEV_ADMIN_ENABLED=true
ULTRA_CONTROL_RUN_RECOVERY_ENABLED=true
ULTRA_CONTROL_RUN_RECOVERY_INTERVAL_SECONDS=30
ULTRA_CONTROL_RUN_RECOVERY_BATCH_LIMIT=1000
# Retention GC: reclaims source + derived artifacts for resources soft-deleted past the
# 30-day undelete window. OFF by default because it PERMANENTLY deletes data (irreversible)
# — enable only after reviewing GET /v2/admin/overview -> retention_backlog.
ULTRA_CONTROL_RETENTION_GC_ENABLED=false
ULTRA_CONTROL_RETENTION_GC_INTERVAL_SECONDS=3600
ULTRA_CONTROL_RETENTION_GC_BATCH=100
ULTRA_RARESPOT_ARTIFACT_ROOT=data/artifacts
ULTRA_RARESPOT_ALLOWED_INPUT_ROOTS=data/uploads:data/sessions
ULTRA_RARESPOT_UPLOAD_ROOTS=data/uploads:data/sessions
ULTRA_RARESPOT_UPLOAD_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/bisque_ultra
ULTRA_RARESPOT_SPECTRAL=true
ULTRA_RARESPOT_NATS_ACK_WAIT_SECONDS=120
ULTRA_RARESPOT_NATS_ACK_PROGRESS_INTERVAL_SECONDS=30
ULTRA_RARESPOT_WORKER_ID=ultra-rarespot-worker-local
ULTRA_RARESPOT_WORKER_KIND=rarespot

# Python Deep Agents runtime
ULTRA_DEEPAGENTS_TIMEOUT_SECONDS=0
# Liveness watchdog for silent model streams only; 0 disables it. This is not a task runtime cap.
ULTRA_DEEPAGENTS_MODEL_STREAM_IDLE_TIMEOUT_SECONDS=0
# Recovery attempts after a silent model stream; keeps the same workspace and does not cap tool runtime.
ULTRA_DEEPAGENTS_MODEL_STREAM_IDLE_MAX_RECOVERIES=2
ULTRA_DEEPAGENTS_MAX_RETRIES=1
# Sidebar-title model call. The call runs concurrently with the run and only
# fires on a thread's first turn; thinking is disabled per call because hybrid
# reasoning models otherwise spend the whole title budget thinking
# (vLLM chat_template_kwargs enable_thinking=false; harmless elsewhere).
ULTRA_DEEPAGENTS_TITLE_THINKING_DISABLED=true
ULTRA_DEEPAGENTS_TITLE_MAX_TOKENS=96
# High LangGraph step ceiling for long Deep Agents runs; keep explicit to avoid low framework defaults.
ULTRA_DEEPAGENTS_RECURSION_LIMIT=1000
# Continuation guard for incomplete autonomous turns; 0 disables it.
ULTRA_DEEPAGENTS_COMPLETION_MAX_CONTINUATIONS=8
# Optional remote LangGraph async subagents for background work. Leave empty
# unless an operator-managed Agent Protocol server and auth contract exist.
# Example: [{"name":"remote-training-runner","description":"Runs long model training jobs.","graph_id":"ultra-training-agent","url":"https://langgraph.example.test","headers":{"X-Ultra-Async-Token":"secret-ref"}}]
ULTRA_DEEPAGENTS_ASYNC_SUBAGENTS_JSON=
# Agent skills directory (progressive-disclosure protocols such as experiment
# rigor and report contracts). Empty uses the repo-shipped
# backend/deepagents_runtime/skills; set an absolute path to override.
ULTRA_DEEPAGENTS_SKILLS_ROOT=
# Durable worker ownership lease. Keep optional in local dev; require it in production workers.
ULTRA_DEEPAGENTS_WORKER_ID=ultra-deepagents-worker-local
ULTRA_DEEPAGENTS_WORKER_KIND=deepagents
ULTRA_DEEPAGENTS_WORKER_MAX_CONCURRENCY=64
ULTRA_DEEPAGENTS_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
ULTRA_DEEPAGENTS_CONTROL_RUN_LEASE_TTL_SECONDS=600
ULTRA_DEEPAGENTS_REQUIRE_CONTROL_RUN_LEASE=false
ULTRA_DEEPAGENTS_SANDBOX_IMAGE=bisque-ultra-codeexec:py311
ULTRA_DEEPAGENTS_SANDBOX_NETWORK=none
# 0/blank means no product-default cap; set these explicitly as operator guardrails.
ULTRA_DEEPAGENTS_SANDBOX_CPUS=0
ULTRA_DEEPAGENTS_SANDBOX_MEMORY=
ULTRA_DEEPAGENTS_SANDBOX_PIDS_LIMIT=0
ULTRA_DEEPAGENTS_SANDBOX_TIMEOUT_SECONDS=0
ULTRA_DEEPAGENTS_SANDBOX_OUTPUT_LIMIT_BYTES=0

# Run + artifact storage
ORCHESTRATOR_API_URL=http://localhost:8000
ORCHESTRATOR_API_TIMEOUT=1800
ORCHESTRATOR_API_KEY=
# Primary run-store backend (Postgres-first)
RUN_STORE_PATH=postgresql://postgres:postgres@localhost:55432/bisque_ultra
# Optional: DSN used by Postgres integration tests (`make test-postgres-store`)
RUN_STORE_POSTGRES_TEST_DSN=postgresql://postgres:postgres@localhost:55432/bisque_ultra_test
# Optional SQLite fallback for local emergency recovery only:
# RUN_STORE_PATH=data/runs.db
ARTIFACT_ROOT=data/artifacts
SESSION_UPLOAD_ROOT=data/sessions
SCIENCE_DATA_ROOT=data/science
UPLOAD_STORE_ROOT=data/uploads
UPLOAD_MAX_FILES_PER_REQUEST=64
UPLOAD_MAX_FILE_SIZE_MB=2048
UPLOAD_VIEWER_MAX_DIMENSION=2048
VIEWER_HDF5_ENABLED=true
VIEWER_HDF5_ATLAS_MAX_VOXELS=16777216
VIEWER_HDF5_ATLAS_MAX_TEXTURE_MB=16
# LLM-authored Python code execution
CODE_EXECUTION_ENABLED=false
CODE_EXECUTION_DEFAULT_BACKEND=docker
CODE_EXECUTION_DURABLE_DEFAULT=true
CODE_EXECUTION_DEFAULT_TIMEOUT_SECONDS=900
CODE_EXECUTION_MAX_TIMEOUT_SECONDS=3600
CODE_EXECUTION_DEFAULT_CPU_LIMIT=2.0
CODE_EXECUTION_DEFAULT_MEMORY_MB=4096
CODE_EXECUTION_DOCKER_IMAGE=bisque-ultra-codeexec:py311
CODE_EXECUTION_DOCKER_NETWORK=none
CODE_EXECUTION_MAX_REPAIR_CYCLES=5
CODE_EXECUTION_MAX_TOTAL_TOOL_CALLS=12
CODE_EXECUTION_POLL_INTERVAL_SECONDS=1.0
TOOL_CALL_NAPKIN_ENABLED=true
TOOL_CALL_NAPKIN_PATH=.bisque/tool_call_memory.md
TOOL_CALL_NAPKIN_SKILL_PATH=SKILL.md
TOOL_CALL_NAPKIN_MAX_CONTEXT_CHARS=3200
# Prompt-scoped workpad pipeline controls (response-quality rollout)
PROMPT_WORKPAD_PIPELINE_ENABLED=false
PROMPT_WORKPAD_REFINEMENT_MODE=legacy
PROMPT_WORKPAD_RETAIN_ON_SUCCESS=false
PROMPT_WORKPAD_RETAIN_ON_FAILURE=true
# Adaptive phase-H output budget (used when PROMPT_WORKPAD_REFINEMENT_MODE=phased)
PROMPT_WORKPAD_PHASE_H_MIN_TOKENS=1400
PROMPT_WORKPAD_PHASE_H_MAX_TOKENS=6000
# Response quality scoring + one-pass repair thresholds
PROMPT_WORKPAD_QUALITY_REPAIR_ENABLED=true
PROMPT_WORKPAD_QUALITY_MAX_META_RATE=0.35
PROMPT_WORKPAD_QUALITY_MIN_COMPLETENESS=0.58
PROMPT_WORKPAD_QUALITY_MIN_NUMERIC_DENSITY=0.45

# OCR backend
OCR_BASE_URL=http://localhost:8000/v1
OCR_API_KEY=EMPTY
OCR_MODEL=deepseek-ai/DeepSeek-OCR
OCR_TIMEOUT=3600

# MedSAM2
MEDSAM2_MODEL_ID=latest
MEDSAM2_RUNTIME_ROOT=data/runtime/MedSAM2
MEDSAM2_CHECKPOINT_DIR=data/models/medsam2/checkpoints
MEDSAM2_DEFAULT_CHECKPOINT=MedSAM2_latest.pt
MEDSAM2_CONFIG_FILE=sam2.1_hiera_t512.yaml
MEDSAM2_MAX_SLICES=160

# SAM3
SAM3_MODEL_ID=data/models/sam3/facebook-sam3
SAM3_ALLOW_REMOTE_DOWNLOAD=false
SAM3_MAX_SLICES=192
SAM3_WINDOW_SIZE=1024
SAM3_WINDOW_OVERLAP=0.25
SAM3_MIN_POINTS=8
SAM3_MAX_POINTS=64
SAM3_POINT_DENSITY=0.0015
SAM3_MASK_THRESHOLD=0.5
SAM3_VOTE_THRESHOLD=0.5
SAM3_MIN_COMPONENT_AREA_RATIO=0.0001
SAM3_MODALITY_HINT=auto
SAM3_REFINE_3D=true
SAM3_FALLBACK_TO_MEDSAM2=true
SAM3_AUTO_ZERO_MASK_FALLBACK_ENABLED=true
SAM3_AUTO_ZERO_MASK_FALLBACK_PROMPT=object
SAM3_AUTO_ZERO_MASK_FALLBACK_PROMPTS=object,foreground,cell,nucleus
SAM3_AUTO_LOW_COVERAGE_FALLBACK_THRESHOLD_PERCENT=0.0
SEQUENCE_MAX_FRAMES_PER_FILE=24
SEQUENCE_FRAME_STRIDE=4

# DepthPro
DEPTH_PRO_MODEL_ID=apple/DepthPro-hf
DEPTH_PRO_USE_FOV_MODEL=true

# Existing BisQue integration
# Point these at the BisQue deployment you want Ultra to read from and write to.
BISQUE_ROOT=http://localhost:8080
BISQUE_SERVER=http://localhost:8080
ULTRA_CONTROL_BISQUE_ROOT_URL=http://localhost:8080
ULTRA_CONTROL_BISQUE_MAX_IMPORT_BYTES=536870912
BISQUE_USER=  # Your BisQue username
BISQUE_USERNAME=  # Same as BISQUE_USER; read by the Go control plane
BISQUE_PASSWORD=  # Your BisQue password
ULTRA_CONTROL_BISQUE_USERNAME=
ULTRA_CONTROL_BISQUE_PASSWORD=
ADMIN_USERNAMES=
BISQUE_AUTH_SESSION_TTL_SECONDS=43200
ANONYMOUS_SESSION_TTL_SECONDS=2592000
