# Ignore every runtime `data/` tree at ANY depth (top-level data/, and nested
# scratch like backend/deepagents_runtime/data/ that the worker/tests create).
# The unanchored `data/` is what does that — a root-anchored `data/*` would leave
# nested data/ dirs untracked and trip the release artifact builder's
# clean-worktree guard (that regression made release CI red). Then, ONLY for the
# root data tree, descend far enough to keep the tracked data/models/yolo/.gitkeep
# placeholder (which keeps the sandbox Dockerfile's `COPY data/models/yolo/` valid
# in a clean clone). Each parent level must be re-included with a leading-slash
# (root-anchored) `!` rule, then its contents re-ignored, or git cannot resurface
# a file under an excluded directory.
data/
!/data/
/data/*
!/data/models/
/data/models/*
!/data/models/yolo/
/data/models/yolo/*
!/data/models/yolo/.gitkeep
# but DO track the committed RareSpot parity golden (the gate the CI/parity test reads)
!backend/deepagents_runtime/tests/data/
!backend/deepagents_runtime/tests/data/rarespot_parity_golden.json
runs/
output/
outputs/
downloads/
downloaded_*/
repro_reports/

# Local reference checkouts
bqapi/

# Internal-only reference material
docs/superpowers/
platform/bisque/
planning/

# Local database / volume exports
sqlite:/
postgresql:/

# Large local model assets and weights. Everything under data/models/yolo stays
# untracked EXCEPT the .gitkeep placeholder (see the data/ block above) — the real
# RareSpot weights (data/models/yolo/RareSpotWeights.pt) bake into the sandbox only
# when present locally; a clean clone builds a weights-less sandbox instead of a
# failed image.
*.pt
!data/models/yolo/.gitkeep
data/runtime/MedSAM2/

# OS/editor noise
.DS_Store
*.swp
*.swo

# Local-only MCP server config (personal; not shared with teammates)
.mcp.json

# Local agent/workflow scratch artifacts
.workflow/
automations/
