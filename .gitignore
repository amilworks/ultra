# Ignore the runtime data tree, but descend into data/ and data/models/ so the
# re-includes further down (the tracked data/models/yolo/.gitkeep placeholder that
# keeps the sandbox Dockerfile's `COPY data/models/yolo/` valid in a clean clone)
# can take effect. A blanket `data/` would exclude the directory outright and no
# `!` rule underneath could resurface anything inside it.
data/*
!data/models/
data/models/*
!data/models/yolo/
data/models/yolo/*
# but DO track the committed RareSpot parity golden (the gate the CI/parity test reads)
!backend/deepagents_runtime/tests/data/
!backend/deepagents_runtime/tests/data/rarespot_parity_golden.json
runs/
output/
outputs/
downloads/
downloaded_*/
repro_reports/

# Local reference checkouts
bqapi/

# Internal-only reference material
docs/superpowers/
platform/bisque/
planning/

# Local database / volume exports
sqlite:/
postgresql:/

# Large local model assets and weights. Everything under data/models/yolo stays
# untracked EXCEPT the .gitkeep placeholder (see the data/ block above) — the real
# RareSpot weights (data/models/yolo/RareSpotWeights.pt) bake into the sandbox only
# when present locally; a clean clone builds a weights-less sandbox instead of a
# failed image.
*.pt
!data/models/yolo/.gitkeep
data/runtime/MedSAM2/

# OS/editor noise
.DS_Store
*.swp
*.swo

# Local-only MCP server config (personal; not shared with teammates)
.mcp.json

# Local agent/workflow scratch artifacts
.workflow/
automations/
