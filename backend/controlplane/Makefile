.PHONY: test integration soak run migrate tidy generate generate-openapi generate-sqlc

generate: generate-openapi generate-sqlc

generate-openapi:
	go run github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@v2.7.0 --config api/oapi-codegen.yaml api/openapi.yaml

generate-sqlc:
	go run github.com/sqlc-dev/sqlc/cmd/sqlc@v1.31.1 generate

test:
	go test ./...

integration:
	ULTRA_CONTROL_DATABASE_URL=$${ULTRA_CONTROL_TEST_DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:55432/bisque_ultra_test} \
		go run ./cmd/ultra-control migrate
	ULTRA_CONTROL_TEST_DATABASE_URL=$${ULTRA_CONTROL_TEST_DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:55432/bisque_ultra_test} \
	ULTRA_CONTROL_TEST_NATS_URL=$${ULTRA_CONTROL_TEST_NATS_URL:-nats://127.0.0.1:4222} \
		go test -p=1 ./internal/app ./internal/eventbus ./internal/httpapi ./internal/store \
			-run 'TestAppPostgresAndNATSFlowPersistsWorkerEventsAcrossRestart|TestAppPostgresAndNATSFlowPersistsThousandEventAutonomousRun|TestAppPostgresAndNATSFlowPersistsMixedToolEventAutonomousRun|TestAppPostgresAndNATSIngestsWorkerEventsPublishedWhileControlPlaneIsDown|TestAppPostgresAndNATSIdempotentRetriesPublishOneDurableJob|TestAppPostgresAndNATSHorizontalIdempotentRetriesPublishOneDurableJob|TestAppPostgresAndNATSCompletionPersistsAssistantTranscriptAcrossRestart|TestAppPostgresRunLeaseSurvivesRestartAndAllowsRecoveryAfterExpiry|TestNATSBusPublishesJobAndRunEvent|TestNATSBusDeduplicatesPublishRetriesByDeterministicMessageID|TestNATSRunEventConsumerSurvivesSubscriberShutdown|TestNATSRunEventConsumerReconcilesExistingUnsafeDefaults|TestNATSRunEventConsumerSupportsMultipleControlPlaneSubscribers|TestPostgresStoreThreadRunEventArtifactFlow|TestPostgresResourceLifecycleMutationRollsBackWithoutAuditEvent|TestPostgresStoreRetentionClaimIsAtomicAndExpiredRestoreIsHidden|TestPostgresStoreRetentionClaimPrioritizesManagedBeforeLimit|TestPostgresStoreLifecycleFenceCandidatesAreStable|TestPostgresStoreUpsertCannotReactivateDeletedOrTransferOwnership|TestPostgresStoreRetentionBlockedRowsAreDurableAndVisible|TestRetentionMigrationRollbackAndReapplyPreservesPurgeTombstones|TestPostgresStoreRejectsDuplicateRunIdempotencyKey|TestPostgresStoreTenantScopedQueriesFilterByUser|TestPostgresStoreResourceReadGrantMakesResourceVisibleToGrantee|TestPostgresStoreGetResourceForUserHonorsActivePublicGrant|TestPostgresStoreResourceShareGrantRevocationRemovesCollaboratorAccess|TestPostgresStoreCompleteRunRepairsSucceededRunMissingResponseText|TestPostgresStoreClearRunLeaseEvictsAnyActiveToken|TestPostgresStoreCreateAndListOrganizations|TestPostgresStoreUpsertsAndListsWorkerHeartbeats' \
			-count=1

soak:
	go test ./internal/runcontrol -run 'TestServiceControlPlaneSoakConcurrentIdempotentRunsAndWorkerEvents|TestServiceControlPlaneSoakHighVolumeToolEventsRemainReplayable' -count=1

run:
	go run ./cmd/ultra-control

migrate:
	go run ./cmd/ultra-control migrate

tidy:
	go mod tidy
