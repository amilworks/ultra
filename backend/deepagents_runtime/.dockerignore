# Keep the image-service build context lean: only the package + the engine-build
# patch script are needed (see Dockerfile.imaging).
.venv
**/__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
.git
data
# Keep the production core sensor smoke available to Dockerfile.worker while
# excluding the rest of the test suite from every image context.
tests/*
!tests/test_sensor_worker_core_smoke.py
*.egg-info
build
dist
