# syntax=docker/dockerfile:1
#
# Deep Agents durable NATS worker (executes chat/agent runs). Build context =
# backend/deepagents_runtime.  docker build -f Dockerfile.worker -t ultra-worker:local .
# Core deps only (no torch/rarespot, no native imaging engine) — the worker calls
# the model endpoint + control plane over HTTP and consumes NATS jobs.
FROM python:3.11-slim AS runtime
ENV PYTHONUNBUFFERED=1
# ca-certificates for HTTPS; the static docker CLI lets the worker drive the host
# Docker daemon (mounted socket) to run code in the sandbox image (execute_python).
ARG DOCKER_CLI_VERSION=27.4.0
# git + ripgrep are worker-side tools: git clones repos for stage_git_repo_for_analysis
# (host-side; the sandbox stays --network none), and ripgrep is the fast, reliable
# backend for the filesystem grep tool (the Python fallback skips files >10 MB).
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git ripgrep \
  && curl -fsSL "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_CLI_VERSION}.tgz" \
     | tar -xz -C /usr/local/bin --strip-components=1 docker/docker \
  && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . /app/deepagents_runtime
# Install only the qualified Python 3.11/x86_64 worker closure, then add the
# release-local package without allowing its metadata to re-resolve dependencies.
RUN pip install --no-cache-dir --only-binary=:all: --require-hashes \
  -r /app/deepagents_runtime/requirements.worker.lock \
  && pip install --no-cache-dir --no-build-isolation --no-deps /app/deepagents_runtime
# Build-time production closure: dependency metadata, the qualified NumPy ABI,
# and both durable worker entry modules must be valid without imaging/dev extras.
RUN pip check \
  && python -c "import numpy; assert numpy.__version__ == '1.26.4'; import ultra_deepagents.agent; import ultra_deepagents.nats_worker"
# Durable run worker; compose can override `command` for other roles.
CMD ["python", "-m", "ultra_deepagents.nats_worker"]
