{
    email ${ACME_EMAIL}
}

${ULTRA_PUBLIC_HOST} {
    encode zstd gzip

    header {
        # HSTS: confirm no sibling host under the parent domain must serve plain
        # HTTP before enabling includeSubDomains; hold `preload` until verified.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # CSP tuned for the Vite SPA + WebGL/WASM scientific viewer (blob/data for
        # tiles & workers). VERIFY the viewer works after deploy and tighten; if a
        # feature breaks, switch this header to Content-Security-Policy-Report-Only
        # first, observe, then enforce.
        Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }

    # All API paths -> the single control-plane instance (loopback). flush_interval
    # -1 keeps SSE (trace/chat) streaming unbuffered. BisQue/Keycloak platform paths
    # are intentionally NOT proxied (out of scope this release).
    @api path /v1/* /v2/* /v3/* /docs* /openapi.json
    handle @api {
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
        }
    }

    # SPA: static files with history-API fallback (the app has no client router).
    # Caching contract: hashed /assets/* are immutable forever; index.html (and
    # any SPA-route fallback to it) is no-cache so a deploy takes effect on the
    # next navigation (etag revalidation = cheap 304) — this also closes the
    # stale-index → 404'd-hashed-assets white-page window after a release swap.
    # Stable public files (hero/bg images, favicon) get 7 days.
    # `precompressed` serves build-time .br/.zst/.gz sidecars with a real
    # Content-Length (falls back to on-the-fly `encode` when absent).
    handle {
        root * /srv/ultra/frontend-current
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        @staticfiles {
            path *.webp *.png *.svg *.ico *.woff2
            not path /assets/*
        }
        header @staticfiles Cache-Control "public, max-age=604800"
        @appshell not path /assets/* *.webp *.png *.svg *.ico *.woff2
        header @appshell Cache-Control "no-cache"
        try_files {path} /index.html
        file_server {
            precompressed br zstd gzip
        }
    }
}

# --- Scaling notes (not active config) --------------------------------------
# Control-plane: single instance for beta. To scale, replace the single
# `reverse_proxy 127.0.0.1:8000` upstream with a load-balanced list and add a
# shared cache; needs session/affinity review for the in-process image cache.
#
# Image-service fan-out: the control-plane calls ONE ULTRA_CONTROL_IMAGE_SERVICE_URL
# (no built-in pool). To spread tile/convert load across N image nodes, run a
# least-conn reverse proxy in front of them and point that env at it, e.g.:
#   :8099 {
#       reverse_proxy COMPUTE_A:8099 COMPUTE_B:8099 {
#           lb_policy least_conn
#           health_uri /healthz
#       }
#   }
#
# Login rate-limiting on /v2/auth/*: use the caddy-ratelimit plugin (requires an
# xcaddy custom build; not in the stock Caddy binary). Lower priority while the
# closed beta uses single-admin dev-auth.
