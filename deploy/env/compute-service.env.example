# Ultra model-agnostic GPU compute service — environment template.
# Copy to /etc/ultra/compute-service.env on the GPU node and fill the secrets.
# This file is loaded both by the systemd unit (container/bind knobs) and inside
# the container (service + executor config).

# --- auth (must match the worker's ULTRA_COMPUTE_SERVICE_TOKEN) ---
ULTRA_COMPUTE_API_KEY=replace-with-private-bearer-token

# --- framework roots ---
ULTRA_COMPUTE_JOB_ROOT=/srv/ultra/compute-service/jobs
ULTRA_COMPUTE_WORKSPACE_ROOT=/srv/ultra/compute-service/work
ULTRA_COMPUTE_MAX_CONCURRENT=1
ULTRA_COMPUTE_HISTORY_LIMIT=200
# Which executors load (comma-separated module stems). The default below loads the
# rarespot training executors ONLY. megaseg_infer is intentionally excluded: this
# image does not bake the megaseg model code (src.science.megaseg_core), so it would
# advertise a capability that fails at run time. Add megaseg_infer only on an image
# that includes that code + ULTRA_MEGASEG_CHECKPOINT_PATH.
ULTRA_COMPUTE_EXECUTORS=rarespot_train,rarespot_evaluate,rarespot_smoke

# --- GPU selection ---
# Pin the container to ONE physical GPU via CUDA_VISIBLE_DEVICES (read before torch
# initializes, inside the container). Pick exactly ONE of these two consistent combos
# — mixing them selects a nonexistent ordinal (CUDA "invalid device ordinal"):
#   (A) ULTRA_COMPUTE_DOCKER_GPUS=all           + CUDA_VISIBLE_DEVICES=<physical ordinal>
#   (B) ULTRA_COMPUTE_DOCKER_GPUS='"device=4"'  + CUDA_VISIBLE_DEVICES=0
# On tesla, GPUs 0-3 run vLLM and GPU4 is free, so combo (A) with CUDA_VISIBLE_DEVICES=4.
CUDA_VISIBLE_DEVICES=0

# --- rarespot executor (baked defaults; override only if the image layout changes) ---
ULTRA_RARESPOT_YOLOV5_PATH=/opt/rarespot/yolov5
# Hard wall-clock cap for a finetune (seconds); the watchdog frees the GPU past this.
# ULTRA_RARESPOT_TRAIN_TIMEOUT_S=21600

# --- megaseg executor (optional; only on an image that bakes src.science.megaseg_core) ---
# ULTRA_MEGASEG_CHECKPOINT_PATH=/srv/ultra/training-data/models/megaseg/epoch_650.ckpt
# ULTRA_MEGASEG_DEVICE=cuda

# --- systemd container / bind settings ---
ULTRA_COMPUTE_SERVICE_PORT=8030
ULTRA_COMPUTE_BIND_ADDRESS=0.0.0.0
ULTRA_COMPUTE_DOCKER_GPUS=all
ULTRA_COMPUTE_SHM_SIZE=8g
# The training data volume, mounted rw at the SAME path in this service AND the
# training worker (that shared-path invariant is how the worker's assembled dataset
# + warm weights are read and best.pt is written back). MODELS_ROOT is read-only.
ULTRA_COMPUTE_SHARED_ROOT=/srv/ultra/training-data
ULTRA_COMPUTE_MODELS_ROOT=/srv/ultra/training-data/models

# =====================================================================
# WORKER SIDE (set these in the training worker's env, NOT here) so the
# adapter offloads GPU work to this service instead of ssh:
#   ULTRA_COMPUTE_SERVICE_URL=http://<this-node>:8030
#   ULTRA_COMPUTE_SERVICE_TOKEN=<same as ULTRA_COMPUTE_API_KEY above>
#   ULTRA_TRAINING_WORKDIR_ROOT=<a subdir under ULTRA_COMPUTE_SHARED_ROOT>
# Leave ULTRA_COMPUTE_SERVICE_URL UNSET on this node so the evaluate executor's
# local kernel never routes back out to a service.
# =====================================================================
