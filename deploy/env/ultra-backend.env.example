# Server-side Ultra backend environment
# Install as /etc/ultra/ultra-backend.env

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Public routing
ULTRA_PUBLIC_HOST=ultra.example.com
ACME_EMAIL=ops@example.com
ULTRA_RELEASE_ROOT=/srv/ultra
ULTRA_CONTROL_HTTP_ADDR=127.0.0.1:8000
ULTRA_CONTROL_BASE_URL=http://127.0.0.1:8000
# Production points Ultra at the operator-managed BisQue deployment.
BISQUE_ROOT=https://bisque2.ece.ucsb.edu
ULTRA_CONTROL_BISQUE_ROOT_URL=https://bisque2.ece.ucsb.edu
ULTRA_CONTROL_BISQUE_USERNAME=
ULTRA_CONTROL_BISQUE_PASSWORD=
ULTRA_CONTROL_BISQUE_MAX_IMPORT_BYTES=536870912

# Shared local storage on the app node
# In a split-node deployment, replace 127.0.0.1 with the private database host
# from your operator inventory or private runbook.
RUN_STORE_PATH=postgresql://ultra:change-me-ultra-db@127.0.0.1:55433/ultra
ULTRA_CONTROL_DATABASE_URL=postgresql://ultra:change-me-ultra-db@127.0.0.1:55433/ultra
ULTRA_CONTROL_NATS_URL=nats://127.0.0.1:4222
# Postgres container/server tuning. The systemd unit always preloads
# pg_stat_statements and enables I/O timing; these bound stats volume/temp files
# and keep new TOAST/WAL payloads compressed.
ULTRA_PG_STAT_STATEMENTS_MAX=10000
ULTRA_PG_STAT_STATEMENTS_TRACK=all
ULTRA_PG_LOG_TEMP_FILES=65536
ULTRA_PG_WAL_COMPRESSION=lz4
ULTRA_PG_DEFAULT_TOAST_COMPRESSION=lz4
# 32-byte AES-GCM key for encrypted BisQue/user integration secrets.
# Generate with: openssl rand -base64 32
ULTRA_CONTROL_SECRET_ENCRYPTION_KEY=
ULTRA_CONTROL_SECRET_ENCRYPTION_KEY_ID=prod-v1
# Shared secret that authenticates Deep Agents / RareSpot workers on the
# run-status, run-lease, and worker-heartbeat endpoints. Required so workers
# can hold durable run leases behind WorkOS-gated deployments.
# Generate with: openssl rand -hex 32
ULTRA_CONTROL_WORKER_TOKEN=
# Code-execution sandbox image for agent runs. The deploy wrapper resolves this
# tag to its immutable image ID and pins workers to that ID, so a retagged or
# rebuilt image cannot silently swap the runtime under a running deployment.
ULTRA_DEEPAGENTS_SANDBOX_IMAGE=bisque-ultra-codeexec:py311
ULTRA_CONTROL_AUTH_PROVIDER=workos
ULTRA_CONTROL_WORKOS_CLIENT_ID=client_replace_me
ULTRA_CONTROL_WORKOS_API_KEY=sk_live_replace_me
ULTRA_CONTROL_WORKOS_REDIRECT_URI=https://ultra.example.com/v2/auth/workos/callback
ULTRA_CONTROL_WORKOS_POST_LOGIN_REDIRECT_URI=https://ultra.example.com/
ULTRA_CONTROL_WORKOS_LOGOUT_REDIRECT_URI=https://ultra.example.com/
# Browser-facing origin (scheme://host, no path) used to make agent-facing links
# absolute (Lens deep links on resource-search / resource-resolve hits). Must be
# the exact origin users browse; unset keeps the links relative (also correct).
ULTRA_CONTROL_PUBLIC_URL=https://ultra.example.com
# Generate with (32+ chars required): openssl rand -hex 32
ULTRA_CONTROL_WORKOS_COOKIE_PASSWORD=
ULTRA_CONTROL_WORKOS_COOKIE_SECURE=true
# Bootstrap admins: comma-separated emails granted the admin role after WorkOS
# sign-in regardless of the WorkOS-reported role. Needed to seed the first admin
# (you can't promote yourself in-app until you already are one). Case-insensitive.
#   ULTRA_CONTROL_ADMIN_EMAILS=you@example.org,teammate@example.org
ULTRA_CONTROL_ADMIN_EMAILS=
ARTIFACT_ROOT=/srv/ultra/shared/artifacts
ULTRA_CONTROL_ARTIFACT_ROOT=/srv/ultra/shared/artifacts
ULTRA_CONTROL_UPLOAD_ROOT=/srv/ultra/shared/uploads
# Deep Agents per-user long-term memory (/memories/*.md). MUST live on the shared
# barrel like artifacts/uploads — otherwise a user's runs on different nodes get
# fragmented memory and learned preferences/research notes silently diverge.
ULTRA_DEEPAGENTS_MEMORY_ROOT=/srv/ultra/shared/deepagents/memory
# Organization-level read-only policy memory (/policies/*.md), shared per org.
ULTRA_DEEPAGENTS_POLICIES_ROOT=/srv/ultra/shared/deepagents/policies
# libbioimage image service (decode/convert + tiled-pyramid tiles). Point at the
# image-service deployment; it must share ULTRA_CONTROL_UPLOAD_ROOT (same volume).
# Empty keeps the legacy native Go image path.
ULTRA_CONTROL_IMAGE_SERVICE_URL=http://ultra-image-service:8099
# --- Beta dev-auth alternative (single admin, no WorkOS) --------------------
# For a closed beta you can run dev-auth instead of WorkOS: set
# ULTRA_CONTROL_AUTH_PROVIDER=dev above, then uncomment the three lines below.
# Only the built-in "admin" account is credential-loginable; set its password
# here (defaults to "admin"). Flip back to WorkOS by reverting AUTH_PROVIDER.
#   ULTRA_CONTROL_ALLOW_DEV_AUTH_IN_PRODUCTION=true
#   ULTRA_CONTROL_DEV_ADMIN_ENABLED=true
#   ULTRA_CONTROL_DEV_ADMIN_PASSWORD=change-me
ULTRA_CONTROL_DEV_ADMIN_ENABLED=false
# Permanently reclaim pyramids/artifacts of soft-deleted resources past their
# undelete window. Off by default; ENABLE in production so disk stays bounded.
ULTRA_CONTROL_RETENTION_GC_ENABLED=true
ULTRA_CONTROL_RETENTION_GC_INTERVAL_SECONDS=3600
ULTRA_CONTROL_RETENTION_GC_BATCH=100
# In-process image-response LRU cache (tiles/atlas/slice/thumbnail), in bytes.
# Larger = more view traffic served from RAM, avoiding re-fetch + the edge NIC.
# 4 GiB suits a many-GiB-RAM edge node serving hundreds of concurrent viewers.
ULTRA_CONTROL_IMAGE_CACHE_BYTES=4294967296
# Per-million-token model prices for the admin "Platform value" cost panel, as a
# JSON object keyed by model id. Unset = the cost panel reports token volume only
# (never a fabricated dollar figure); models absent from the map are listed as
# unpriced. Keys are matched case-insensitively.
#   ULTRA_CONTROL_MODEL_PRICES={"deepseek_v4":{"input_per_mtok":0.27,"output_per_mtok":1.10}}
ULTRA_CONTROL_MODEL_PRICES=
# Serving DB pool (small DB, modest warm pool) + image-service client conns +
# per-query serving timeout (migrations are exempt).
ULTRA_CONTROL_DATABASE_MAX_CONNS=20
ULTRA_CONTROL_DATABASE_MIN_CONNS=4
ULTRA_CONTROL_IMAGE_SERVICE_MAX_CONNS=64
ULTRA_CONTROL_DATABASE_STATEMENT_TIMEOUT_SECONDS=30
ULTRA_CONTROL_RUN_RECOVERY_ENABLED=true
ULTRA_CONTROL_RUN_RECOVERY_INTERVAL_SECONDS=30
ULTRA_CONTROL_RUN_RECOVERY_BATCH_LIMIT=1000
ULTRA_RARESPOT_ARTIFACT_ROOT=/srv/ultra/shared/artifacts
ULTRA_RARESPOT_ALLOWED_INPUT_ROOTS=/srv/ultra/shared/uploads:/srv/ultra/shared/science
ULTRA_RARESPOT_UPLOAD_ROOTS=/srv/ultra/shared/uploads:/srv/ultra/shared/sessions
ULTRA_RARESPOT_UPLOAD_DATABASE_URL=postgresql://ultra:change-me-ultra-db@127.0.0.1:55433/ultra
ULTRA_RARESPOT_SPECTRAL=true
SESSION_UPLOAD_ROOT=/srv/ultra/shared/sessions
UPLOAD_STORE_ROOT=/srv/ultra/shared/uploads

# Local RareSpot model weights on the app node
YOLOV5_RARESPOT_WEIGHTS=/srv/ultra/models/yolo/RareSpotWeights.pt

# Model routing
# Replace 127.0.0.1 with your private inference host if the model server runs
# on a separate machine.
OPENAI_BASE_URL=http://127.0.0.1:8003/v1
OPENAI_MODEL=gpt-oss-120b
OPENAI_API_KEY=EMPTY
# Stable runtime-owned identity emitted in run.token_usage evidence. This is
# not a URL or credential and must describe the actual serving backend.
ULTRA_DEEPAGENTS_MODEL_PROVIDER_ID=self-hosted-vllm
# Served model's input context window (vLLM /v1/models max_model_len). Publishing it
# switches deepagents summarization from the conservative no-profile fallback
# (compact at 170k tokens, keep 6 messages) to adaptive 85%-trigger / 10%-keep, so
# long autonomous and large batch runs use the full window before compacting. MUST
# match the served model (too high = the agent overflows before summarizing). 0/unset
# keeps the safe fallback. Example for gpt-oss-120b (131072-token window):
ULTRA_DEEPAGENTS_MODEL_MAX_INPUT_TOKENS=131072
ULTRA_DEEPAGENTS_TIMEOUT_SECONDS=0
# Idle/stall watchdog: recover the run if the event stream is silent this long (1h = only a
# true dead-transport stall, never slow-but-alive work, which keeps emitting events). 0 disables.
ULTRA_DEEPAGENTS_MODEL_STREAM_IDLE_TIMEOUT_SECONDS=3600
# Recovery attempts after a silent model stream; keeps the same workspace and does not cap tool runtime.
ULTRA_DEEPAGENTS_MODEL_STREAM_IDLE_MAX_RECOVERIES=2
# Per-task wall-clock deadline for BOUNDED subagents only (vision-reasoner, literature-reviewer):
# a hung one returns a degraded result and the run continues, instead of stalling until the 1h idle
# watchdog. 1800s (30m) is well above their measured legit work (vision p90 ~22m); the computational
# delegates (code-runner, qwen-code-runner, builder) are EXCLUDED in code since they legitimately run
# 30-67m. Failure ISOLATION (a crashing subagent -> degraded, not a whole-run abort) applies to ALL
# subagents regardless of this value. 0 disables the deadline (isolation stays on).
ULTRA_DEEPAGENTS_SUBAGENT_TASK_TIMEOUT_SECONDS=1800
# High LangGraph step ceiling for long Deep Agents runs; keep explicit to avoid low framework defaults.
ULTRA_DEEPAGENTS_RECURSION_LIMIT=1000
# The Builder - a model-agnostic autonomous-coding sub-coordinator the coordinator delegates a
# verify-driven GOAL to (it owns the full build loop and returns only when the goal is met or its
# budget is spent). MODEL-AGNOSTIC: point BASE_URL/MODEL at any OpenAI-compatible endpoint. The
# endpoint MUST be served with tool-calling enabled (vLLM: --enable-auto-tool-choice
# --tool-call-parser <parser>) - a vision-only serve cannot drive the agentic loop. Off by default;
# when BASE_URL/MODEL are unset the Builder falls back to the coordinator's own model.
# NOTE: if BASE_URL points at the same endpoint serving the vision-reasoner, a long Builder run
# competes for that GPU's slots and can head-of-line-block live vision; give coding its own served
# instance for production-scale concurrency.
ULTRA_DEEPAGENTS_BUILDER_ENABLED=false
ULTRA_DEEPAGENTS_BUILDER_BASE_URL=
ULTRA_DEEPAGENTS_BUILDER_MODEL=
# Provide the key inline OR via a file path (the file wins only if the inline var is unset):
ULTRA_DEEPAGENTS_BUILDER_API_KEY=
ULTRA_DEEPAGENTS_BUILDER_API_KEY_FILE=
# Builder model's served context window (e.g. 262144 for a 262K Qwen serve). 0 keeps the fallback.
ULTRA_DEEPAGENTS_BUILDER_MAX_INPUT_TOKENS=0
# true if the Builder model can SEE; gives it inspect_images to visually self-check its own figures.
ULTRA_DEEPAGENTS_BUILDER_MULTIMODAL=false
# GoalLoop pathology cap: max times the Builder is re-prompted to keep working toward an unmet goal
# (never a depth/quality cap; a build making real progress is not throttled by it).
ULTRA_DEEPAGENTS_BUILDER_GOAL_MAX_ITERATIONS=6
ULTRA_DEEPAGENTS_BUILDER_RECURSION_LIMIT=400
# Optional SPLIT-MODEL Builder: the lead loop (plan/decide/verify) runs the BUILDER model above
# while the sub-workers it delegates focused sub-runs to run THIS endpoint - e.g. lead=deepseek/H200
# (fast reasoning), workers=Qwen/tesla (coding-tuned, offloads heavy execution onto the other GPU).
# UNSET => workers run the SAME model as the Builder lead (no second endpoint contacted) - default
# is unchanged single-model behavior. The speedup only materializes on PARALLELIZABLE/repeatable
# work (sweeps, per-trial/per-image batches), not a single sequential dependent chain. Same
# tool-calling serve requirement as the lead; set MAX_INPUT_TOKENS to the worker's served window
# (e.g. 262144 for Qwen) so its summarization sizes correctly.
ULTRA_DEEPAGENTS_BUILDER_WORKER_BASE_URL=
ULTRA_DEEPAGENTS_BUILDER_WORKER_MODEL=
ULTRA_DEEPAGENTS_BUILDER_WORKER_API_KEY=
ULTRA_DEEPAGENTS_BUILDER_WORKER_API_KEY_FILE=
ULTRA_DEEPAGENTS_BUILDER_WORKER_MAX_INPUT_TOKENS=0
# EXPERIMENTAL async subagents. Federate to an EXTERNAL Agent Protocol / LangGraph
# deployment (NOT Ultra's in-process NATS workers); the only viable config is HTTP
# to a remote deployment Ultra does not currently run, and this path is unverified
# against a live server. Prefer the NATS run backbone for in-Ultra background work.
# Requires BOTH the enable flag AND non-empty JSON; the server URL must be public
# (private/localhost rejected unless ALLOW_PRIVATE is set).
ULTRA_DEEPAGENTS_ENABLE_ASYNC_SUBAGENTS=
# Example: [{"name":"remote-training-runner","description":"Runs long model training jobs.","graph_id":"ultra-training-agent","url":"https://langgraph.example.test","headers":{"X-Ultra-Async-Token":"secret-ref"}}]
ULTRA_DEEPAGENTS_ASYNC_SUBAGENTS_JSON=
ULTRA_DEEPAGENTS_ALLOW_PRIVATE_ASYNC_SUBAGENT_URL=
# Agent skills directory (progressive-disclosure protocols such as experiment
# rigor and report contracts). Empty uses the repo-shipped
# backend/deepagents_runtime/skills; set an absolute path to override.
ULTRA_DEEPAGENTS_SKILLS_ROOT=
ULTRA_DEEPAGENTS_WORKER_ID=ultra-deepagents-worker-1
ULTRA_DEEPAGENTS_WORKER_KIND=deepagents
ULTRA_DEEPAGENTS_WORKER_MAX_CONCURRENCY=64
ULTRA_DEEPAGENTS_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
ULTRA_DEEPAGENTS_CONTROL_RUN_LEASE_TTL_SECONDS=600
ULTRA_DEEPAGENTS_REQUIRE_CONTROL_RUN_LEASE=true
# Code-exec sandbox per-container envelope + per-worker concurrency. Policy: scientists get
# generous compute, but each container keeps a FINITE memory/CPU/pids ceiling so one runaway
# run is cgroup-OOM-killed / CPU-throttled in isolation instead of taking down the node (and
# with it Postgres/NATS/the worker — ALL tenants). Crucially, SANDBOX_MAX_CONCURRENCY bounds how
# many containers ONE worker can launch at once: with the Builder enabled a single request fans
# out (coordinator -> builder loop -> its sub-workers -> many execute()), so without it the host
# blast radius is unbounded. Size MEMORY x MAX_CONCURRENCY to fit the node. Keep NETWORK=none —
# the sandbox is offline and cannot pip install (the image ships a fixed scientific stack).
# (Workers run on the compute node, so set these in its env.)
ULTRA_DEEPAGENTS_SANDBOX_NETWORK=none
ULTRA_DEEPAGENTS_SANDBOX_CPUS=8
ULTRA_DEEPAGENTS_SANDBOX_MEMORY=32g
ULTRA_DEEPAGENTS_SANDBOX_PIDS_LIMIT=4096
# Max simultaneous sandbox containers per worker PROCESS (0 = unlimited = unbounded host blast
# radius). The real aggregate backstop; a saturated cap returns a retryable "busy", never an OOM.
ULTRA_DEEPAGENTS_SANDBOX_MAX_CONCURRENCY=8
# /dev/shm size. Docker's 64MB default crashes parallel scientific work (torch
# DataLoader workers, joblib/loky, OpenCV, multiprocessing shared arrays) with an
# opaque "Bus error". Set generously.
ULTRA_DEEPAGENTS_SANDBOX_SHM_SIZE=8g
# GPU passthrough for in-sandbox code. Empty = no GPU in the sandbox (GPU inference is
# reached via the MegaSeg/RareSpot services). Set to "all" ONLY on a node whose Docker
# daemon has the NVIDIA container runtime, or `docker run` fails.
ULTRA_DEEPAGENTS_SANDBOX_GPUS=
# Wall-clock ceiling on a single execute() (6h). Bounds a true zombie container while
# allowing long scientific batch work; the stream-idle watchdog + memory cgroup catch
# runaways sooner. 0 disables it (a latent infinite-hang — not recommended).
ULTRA_DEEPAGENTS_SANDBOX_TIMEOUT_SECONDS=21600
ULTRA_DEEPAGENTS_SANDBOX_OUTPUT_LIMIT_BYTES=52428800
# Sandbox-container reaper (best-effort backstop; primary cleanup is `docker run --rm`).
# It removes leftover STOPPED sandbox containers (rare AutoRemove-failure/daemon-restart
# residue) and force-kills RUNNING orphans whose age exceeds their own cap+grace (a
# container whose launching execute() already timed out). It ONLY ever touches containers
# labeled ultra.sandbox=1, so it never disturbs postgres/megaseg/codeexec/other tenants on
# a shared daemon. INTERVAL=0 disables the periodic loop (the startup sweep still runs).
# GRACE must comfortably exceed any worker/daemon clock skew.
ULTRA_DEEPAGENTS_SANDBOX_REAPER_INTERVAL_SECONDS=300
ULTRA_DEEPAGENTS_SANDBOX_REAPER_GRACE_SECONDS=600
ULTRA_DEEPAGENTS_SANDBOX_REAPER_MAX_PER_SWEEP=200

# Host-side Git repo staging: the agent can clone an allowlisted public repo into
# /workspace so the (still --network none) sandbox runs it on staged data. The
# clone runs in the WORKER process, so the worker host/image needs `git` AND
# `ripgrep` installed (ripgrep also backs the fast filesystem grep tool). HTTPS-only,
# no credentials are ever sent; pin reproducibility with a ref/commit.
ULTRA_DEEPAGENTS_ENABLE_GIT_STAGING=true
ULTRA_DEEPAGENTS_GIT_STAGING_ALLOWED_HOSTS=github.com
ULTRA_DEEPAGENTS_GIT_STAGING_MAX_BYTES=2147483648
ULTRA_DEEPAGENTS_GIT_STAGING_TIMEOUT_SECONDS=600
ULTRA_DEEPAGENTS_GIT_STAGING_DEPTH=1
# Process-wide cap on simultaneous clones (bounds aggregate disk footprint vs.
# worker concurrency). On a shared-disk node, keep workspace_root on its own
# volume so a clone flood degrades only agent runs, not Postgres/NATS.
ULTRA_DEEPAGENTS_GIT_STAGING_MAX_CONCURRENT_CLONES=4
# Reclaim per-run scratch workspaces older than this many seconds (0 disables).
# Durable artifacts live under the artifact root, so this never deletes deliverables.
ULTRA_DEEPAGENTS_WORKSPACE_RETENTION_SECONDS=604800

# Optional Megaseg GPU service override
MEGASEG_SERVICE_URL=
MEGASEG_SERVICE_API_KEY=

# Batch analysis worker (ultra-analysis-worker, `python -m ultra_deepagents.analysis`,
# compute role). Consumes ultra.data_agent.jobs for analysis.megaseg / analysis.rarespot.
# It reuses MEGASEG_SERVICE_URL/_API_KEY (calls the GPU /v1/infer), ULTRA_CONTROL_BASE_URL
# (registers outputs), ULTRA_CONTROL_NATS_URL (data-agent jobs), and ULTRA_CONTROL_UPLOAD_ROOT
# (writes results into the SHARED upload volume, then registers metadata-only).
# Full synchronous segmentation can take minutes — give /v1/infer a long timeout:
ULTRA_ANALYSIS_MEGASEG_TIMEOUT_SECONDS=1800
# Roots scanned to resolve an input resource_id -> its file (defaults to the shared upload root):
ULTRA_ANALYSIS_UPLOAD_ROOTS=/srv/ultra/shared/uploads:/srv/ultra/shared/sessions
# Where results are written before metadata-only registration (must equal ULTRA_CONTROL_UPLOAD_ROOT):
ULTRA_ANALYSIS_OUTPUT_ROOT=/srv/ultra/shared/uploads
