upstream ultra_backend {
    server 127.0.0.1:8001;
    server 127.0.0.1:8002;
    keepalive 32;
}

upstream ultra_control {
    server 127.0.0.1:8000;
    keepalive 32;
}

map $$http_upgrade $$connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name ${ULTRA_PUBLIC_HOST};

    client_max_body_size 2048M;

    # Content Security Policy — defense-in-depth for the chat surface (agent
    # output is prompt-injectable). Shipped as Report-Only so it CANNOT break
    # rendering: validate the browser violation reports in staging, then rename
    # the header to `Content-Security-Policy` to enforce. In this single-host
    # topology BisQue is proxied SAME-ORIGIN (/client_service/ etc.), so no
    # external host is needed. Production build has no inline <script>; runtime
    # inline <style> (shadcn ChartStyle, katex) needs style-src 'unsafe-inline';
    # shiki uses the JS regex engine (no wasm/eval).
    add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;

    root /srv/ultra/frontend-current;
    index index.html;

    location /v2/ {
        proxy_pass http://ultra_control;
        proxy_http_version 1.1;
        proxy_set_header Host $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
        proxy_set_header Upgrade $$http_upgrade;
        proxy_set_header Connection $$connection_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /v1/health {
        proxy_pass http://ultra_control;
        proxy_http_version 1.1;
        proxy_set_header Host $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /v1/config {
        proxy_pass http://ultra_control;
        proxy_http_version 1.1;
        proxy_set_header Host $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /v1/session {
        proxy_pass http://ultra_control;
        proxy_http_version 1.1;
        proxy_set_header Host $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /v1/ {
        proxy_pass http://ultra_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /v3/ {
        proxy_pass http://ultra_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /openapi.json {
        proxy_pass http://ultra_backend;
        proxy_set_header Host $$host;
        proxy_set_header X-Forwarded-Proto $$scheme;
    }

    location /docs {
        proxy_pass http://ultra_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $$host;
        proxy_set_header X-Forwarded-Proto $$scheme;
    }

    # BisQue is path-sensitive. Keep its native service namespaces at the domain root.
    location ~ ^/(auth_service|blob_service|client_service|data_service|dataset_service|export_service|features|image_service|import|mex|module_service|notebook_service|registration|table_service)(/|$$) {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /bisque {
        return 302 /client_service/;
    }

    location = /bisque/ {
        return 302 /client_service/;
    }

    location / {
        try_files $$uri $$uri/ /index.html;
    }
}
