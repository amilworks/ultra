{
  "name": "bisque-ultra-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typography:check && tsc -b && vite build && pnpm run typography:check:dist",
    "lint": "eslint --no-error-on-unmatched-pattern src --ext .ts,.tsx scripts/*.mjs vite.config.ts vitest.config.ts eslint.config.js",
    "bench:ui": "node scripts/ui-performance-benchmark.mjs",
    "bench:ui:prod": "pnpm run build && BENCH_MODE=preview node scripts/ui-performance-benchmark.mjs",
    "bench:ui:prod:strict": "pnpm run build && BENCH_MODE=preview BENCH_ENFORCE=1 node scripts/ui-performance-benchmark.mjs",
    "bundle:check": "node scripts/check-bundle-budgets.mjs",
    "typography:check": "node scripts/check-typography-contract.mjs",
    "typography:check:dist": "node scripts/check-typography-contract.mjs --dist",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:smoke": "pnpm run test:smoke-safety && node scripts/run-mobile-smoke.mjs",
    "mobile:smoke": "pnpm run test:smoke",
    "test:smoke-safety": "node --test scripts/smoke-safety.test.mjs"
  },
  "dependencies": {
    "@milkdown/kit": "^7.22.0",
    "@milkdown/react": "^7.22.0",
    "@sparkjsdev/spark": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "js-yaml": "^5.0.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.10",
    "recharts": "3.8.1",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "use-stick-to-bottom": "^1.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "shadcn": "4.8.3",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
